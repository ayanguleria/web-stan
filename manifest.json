{
  "manifest_version": 3,
  "name": "Web Stan",
  "version": "1.1",
  "description": "Track your top visited sites daily and weekly",
  "permissions": ["storage", "tabs", "alarms", "idle", "favicon"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Web Stan",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  }
}